# ==============================================================================
# Database Configuration
# ==============================================================================
POSTGRES_DSN=postgresql://postgres:password@localhost:5432/rag_db


# ==============================================================================
# Document Storage Configuration (MinIO / AWS S3)
# ==============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=docstore


# ==============================================================================
# Authentication Configuration (Clerk)
# ==============================================================================
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Set this to "false" if you want to allow Document uploads to auto-generate
# floating organizations when the specified organization_id fails validation.
REQUIRE_ORG_VALIDATION=false


# ==============================================================================
# AI Parse Legislation Configuration (OpenAI Native)
# ==============================================================================
OPENAI_API_KEY=sk-...


# ==============================================================================
# Evaluation Agent Configuration (OpenRouter API) 
# ==============================================================================
OPENROUTER_API_KEY=sk-...
OPENROUTER_MODEL=openai/gpt-4o
AGENT_MAX_TOOL_CALLS=25


# ==============================================================================
# Legislation Templates Configuration
# ==============================================================================
# Path to directory containing YAML agent instruction templates.
# Defaults to ./legislation-templates relative to the working directory.
LEGISLATION_TEMPLATES_DIR=legislation-templates
